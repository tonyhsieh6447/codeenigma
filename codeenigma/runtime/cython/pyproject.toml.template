[tool.poetry]
name = "codeenigma_runtime"
version = $version
description = "CodeEnigma Runtime"
authors = ["CodeEnigma Team <team@codeenigma.com>"]
include = [
    { path = "$so_file_path", format = "wheel" }
]

[tool.poetry.dependencies]
python = ">=3.8, <3.14"
cryptography = ">=40.0.4"
rich = ">=13.0.0"
setuptools = ">=70.0.0"
cython = ">=3.0.0"
toml = ">=0.9.2"
tomli = {version = "^2.0.1", markers = "python_version < '3.11'"}
importlib-metadata = {version = "^4.6.0", markers = "python_version < '3.8'"}

[build-system]
requires = ["poetry-core>=1.0.0"]
build-backend = "poetry.core.masonry.api"
